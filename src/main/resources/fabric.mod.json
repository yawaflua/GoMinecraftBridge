{
  "schemaVersion": 1,
  "id": "gbm",
  "icon": "icon.png",
  "version": "${version}",
  "name": "GBM",
  "description": "GoBridgeMinecraft native plugin runtime and package manager.",
  "authors": [
    "yawaflua"
  ],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "mixins": [
    "gbm.client.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "dev.yawaflua.gominecraftbridge.GoMinecraftBridgeMod"
    ],
    "client": [
      "dev.yawaflua.gominecraftbridge.client.GoMinecraftBridgeClient"
    ],
    "modmenu": [
      "dev.yawaflua.gominecraftbridge.client.GoBridgeModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "cloth-config": ">=26.1.154",
    "modmenu": ">=18.0.0"
  }
}
